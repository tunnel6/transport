#!/usr/bin/env bash
set -euo pipefail

REAL_CLANGXX="/opt/homebrew/opt/llvm@21/bin/clang++"
if [[ ! -x "$REAL_CLANGXX" ]]; then
  REAL_CLANGXX="/usr/bin/clang++"
fi

args=()
expect_imsvc_path=0
for arg in "$@"; do
  if [[ "$expect_imsvc_path" == "1" ]]; then
    args+=("-isystem" "$arg")
    expect_imsvc_path=0
    continue
  fi

  case "$arg" in
    /imsvc)
      expect_imsvc_path=1
      ;;
    /EHsc)
      args+=("-fexceptions")
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

exec "$REAL_CLANGXX" "${args[@]}"
